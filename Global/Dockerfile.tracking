# syntax=docker/dockerfile:1
FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

COPY --from=ghcr.io/astral-sh/uv:0.9.26@sha256:9a23023be68b2ed09750ae636228e903a54a05ea56ed03a934d00fe9fbeded4b /uv /uvx /usr/local/bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUTF8=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    HOME=/tmp \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /opt/tracking
COPY Global/pyproject.toml Global/uv.lock Global/.python-version ./
RUN uv sync --locked --only-group tracking-server --no-install-project --no-cache \
    && mkdir -p /var/lib/mlflow/artifacts \
    && chown -R 10001:10001 /var/lib/mlflow
COPY Global/scripts/start_tracking_server.py ./start_tracking_server.py

USER 10001:10001
EXPOSE 5000
ENTRYPOINT ["python", "/opt/tracking/start_tracking_server.py"]
CMD ["serve"]
