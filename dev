#!/bin/sh
# Run tools in the workspace; each experiment owns its Python code and packages.
set -eu

repo_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
cd "$repo_dir"

service=cpu
service_explicit=0
if [ "${1:-}" = --gpu ]; then
    service=gpu
    service_explicit=1
    shift
fi
command=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
if [ "${1:-}" = --gpu ]; then
    service=gpu
    service_explicit=1
    shift
fi

case "$command" in
    help|-h|--help)
        cat <<'HELP'
사용법: ./dev <작업> [--gpu] [인자]

  up -d --wait        Docker 환경 준비·Jupyter 시작 (--gpu: NVIDIA GPU)
  down / build       종료 / 이미지 갱신
  check / status     기본 패키지 점검 / 현재 설정
  url / shell        Jupyter 주소 / 컨테이너 터미널
  setup              개인 ID 설정 (--uri 서버주소 --username 계정 --password)
  upload <결과폴더>   지표·설정·파일 등록 (--model 모델파일또는폴더)
  exec <작업폴더> <파일.py> [인자]  개인 환경에서 실행
  notebook <작업폴더> 노트북 생성·개인 패키지 커널 연결
  env <작업> <폴더>   add/remove/sync/status/kernel/isolate/share
  deps <작업>        공통 패키지 add/remove/lock/export
  verify / test / lint / hooks  검사 / 테스트 / 코드 정리 / 커밋 전 검사
  tracking <작업>    공용 서버 up/down/logs/status/user

컨테이너와 Jupyter 터미널에서는 dev 명령을 사용합니다.
상세 도움말: ./dev <명령> --help
HELP
        exit 0
        ;;
    hooks)
        if [ "$#" -ne 0 ]; then
            echo '사용법: ./dev hooks' >&2
            exit 2
        fi
        current_hooks=$(git config --get core.hooksPath || true)
        if [ -n "$current_hooks" ] && [ "$current_hooks" != .githooks ]; then
            echo "기존 Git hooksPath 설정을 유지합니다: $current_hooks" >&2
            echo '.githooks로 변경하려면 기존 설정을 먼저 확인하세요.' >&2
            exit 2
        fi
        git config --local core.hooksPath .githooks
        echo '커밋 전 검사를 연결했습니다: .githooks'
        exit 0
        ;;
esac

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    echo 'Docker와 Docker Compose를 먼저 준비하세요. Global/docs/development.md를 확인하세요.' >&2
    exit 2
fi

if [ "$command" = tracking ]; then
    if [ ! -f "$repo_dir/.env.tracking" ]; then
        echo '.env.tracking.example을 .env.tracking으로 복사하고 서버 설정을 입력하세요. Global/docs/tracking-server.md를 확인하세요.' >&2
        exit 2
    fi
    tracking_compose() {
        docker compose --project-directory "$repo_dir" \
            --env-file "$repo_dir/.env.tracking" -f "$repo_dir/compose.tracking.yaml" "$@"
    }
    action=${1:-help}
    if [ "$#" -gt 0 ]; then shift; fi
    case "$action" in
        up) tracking_compose up --build -d --wait "$@" ;;
        down) tracking_compose down "$@" ;;
        logs) tracking_compose logs "$@" ;;
        status) tracking_compose ps "$@" ;;
        user)
            if [ "$#" -ne 1 ]; then
                echo '사용법: ./dev tracking user <계정명>' >&2
                exit 2
            fi
            tracking_compose exec tracking python /opt/tracking/start_tracking_server.py user "$1"
            ;;
        *)
            echo '사용법: ./dev tracking <up|down|logs|status|user 계정명>' >&2
            exit 2
            ;;
    esac
    exit 0
fi

# Bind-mounted outputs belong to the person running the command, not root.
POC_UID=$(id -u)
POC_GID=$(id -g)
export POC_UID POC_GID

compose() {
    docker compose --project-directory "$repo_dir" -f "$repo_dir/compose.yaml" "$@"
}

# Tools and commit hooks use the active workspace, including a GPU-only checkout.
case "$command" in
    up|down|build) ;;
    *)
        if [ "$service_explicit" = 0 ] \
            && [ -z "$(compose ps --status running --quiet cpu)" ] \
            && [ -n "$(compose ps --status running --quiet gpu)" ]; then
            service=gpu
        fi
        ;;
esac

run() {
    command_context=container
    if [ "${1:-}" = dev ]; then command_context=host; fi
    running=$(compose ps --status running --quiet "$service")
    if [ -n "$running" ]; then
        if [ "${POC_NO_TTY:-0}" = 1 ] || [ ! -t 0 ] || [ ! -t 1 ]; then
            compose exec -T -e SIXLETTERS_COMMAND_CONTEXT="$command_context" \
                -e SIXLETTERS_COMMAND_GPU="$service" "$service" poc-container "$@"
        else
            compose exec -e SIXLETTERS_COMMAND_CONTEXT="$command_context" \
                -e SIXLETTERS_COMMAND_GPU="$service" "$service" poc-container "$@"
        fi
    else
        if [ "${POC_NO_TTY:-0}" = 1 ] || [ ! -t 0 ] || [ ! -t 1 ]; then
            compose run --rm --no-deps -T -e SIXLETTERS_COMMAND_CONTEXT="$command_context" \
                -e SIXLETTERS_COMMAND_GPU="$service" "$service" "$@"
        else
            compose run --rm --no-deps -e SIXLETTERS_COMMAND_CONTEXT="$command_context" \
                -e SIXLETTERS_COMMAND_GPU="$service" "$service" "$@"
        fi
    fi
}

case "$command" in
    status)
        compose ps
        if [ -z "$(compose ps --status running --quiet "$service")" ]; then
            echo '작업 환경이 꺼져 있습니다. 다음: ./dev up -d --wait (GPU: --gpu)'
            exit 0
        fi
        # A stale image must still be able to explain why it needs rebuilding.
        compose exec -T -e POC_SKIP_DEPENDENCY_CHECK=1 -e SIXLETTERS_COMMAND_CONTEXT=host \
            -e SIXLETTERS_COMMAND_GPU="$service" "$service" poc-container python -m sixletters status "$@"
        ;;
    url)
        if [ "$#" -ne 0 ]; then echo '사용법: ./dev url' >&2; exit 2; fi
        if [ -z "$(compose ps --status running --quiet "$service")" ]; then
            echo '작업 환경을 먼저 시작하세요: ./dev up -d --wait' >&2
            exit 2
        fi
        echo '아래 토큰은 개인 접속용입니다. 공유 문서·PR에 복사하지 마세요.'
        compose exec -T "$service" poc-container jupyter server list
        ;;
    deps)
        dependency_command=${1:-help}
        if [ "$#" -gt 0 ]; then shift; fi
        case "$dependency_command" in
            add|remove)
                compose run --rm --no-deps -T -e POC_SKIP_DEPENDENCY_CHECK=1 "$service" \
                    uv "$dependency_command" --project Global --no-sync "$@"
                ;;
            lock)
                compose run --rm --no-deps -T -e POC_SKIP_DEPENDENCY_CHECK=1 "$service" uv lock --project Global "$@"
                ;;
            export)
                compose run --rm --no-deps -T -e POC_SKIP_DEPENDENCY_CHECK=1 "$service" uv export --project Global \
                    --locked --no-dev --no-emit-project --output-file Global/requirements.txt "$@"
                ;;
            *)
                echo '사용법: ./dev deps <add|remove|lock|export> [uv 인자]' >&2
                exit 2
                ;;
        esac
        ;;
    build)
        compose build "$service" "$@"
        ;;
    check)
        if [ "$service" = gpu ]; then
            run python Global/scripts/check_environment.py --gpu "$@"
        else
            run python Global/scripts/check_environment.py "$@"
        fi
        ;;
    shell)
        run bash "$@"
        ;;
    up)
        compose up --build "$service" "$@"
        echo 'Jupyter 접속 주소·토큰: ./dev url | 상태 확인: ./dev status'
        ;;
    notebook)
        if [ "$#" -eq 0 ]; then
            compose up --build "$service"
        else
            run dev notebook "$@"
        fi
        ;;
    verify)
        run python Global/scripts/verify_changes.py "$@"
        ;;
    down)
        compose --profile gpu down "$@"
        ;;
    test)
        run pytest -c Global/pyproject.toml -q "$@"
        ;;
    lint)
        if [ "${1:-}" = --staged ]; then
            shift
            run pre-commit run "$@"
        else
            run pre-commit run --all-files "$@"
        fi
        ;;
    *)
        run dev "$command" "$@"
        ;;
esac
