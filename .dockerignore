# Only environment definitions and executable source enter the image build.
**
!Global/
!Global/Dockerfile
!Global/Dockerfile.tracking
!Global/pyproject.toml
!Global/uv.lock
!Global/.python-version
!Global/src/
!Global/src/**/
!Global/src/**/*.py
!Global/scripts/
!Global/scripts/*.py

# Never include local data, model weights, credentials or generated files.
**/__pycache__/**
**/*.py[cod]
**/.env
**/.env.*
**/.poc.local.toml
**/.poc-cache/**
**/.git/**
**/.venv/**
Global/data/**
Global/artifacts/**
Members/**
**/*.csv
**/*.parquet
**/*.dat
**/*.hea
**/*.edf
**/*.pkl
**/*.pickle
**/*.joblib
**/*.pt
**/*.pth
**/*.onnx
**/*.h5
**/*.hdf5
**/*.npy
**/*.npz
**/*.pem
**/*.key
**/*.zip
**/*.tar
**/*.gz
