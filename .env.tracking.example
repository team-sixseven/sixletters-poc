# Copy to .env.tracking on the shared server. Do not commit the completed file.
MLFLOW_AUTH_ADMIN_USERNAME=
# Required for the first start. Remove this value after creating the administrator.
# Later password changes use MLflow's user management API, not this setting.
# Enclose the password in single quotes so $ characters stay literal.
MLFLOW_AUTH_ADMIN_PASSWORD=
# Keep the same random secret across server restarts (at least 32 characters).
MLFLOW_FLASK_SERVER_SECRET_KEY=

# Default access is local only. For team access, bind a private/VPN address or
# use a TLS reverse proxy. Add the exact host:port used by clients below.
POC_MLFLOW_BIND_HOST=127.0.0.1
POC_MLFLOW_PORT=5000
MLFLOW_SERVER_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
